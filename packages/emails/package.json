{
  "name": "@tablekeep/emails",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./emails/*": "./src/emails/*.tsx",
    "./styles": "./src/styles/index.ts",
    "./styles/*": "./src/styles/*",
    "./types/*": "./src/types/*.ts"
  },
  "scripts": {
    "dev": "email dev --dir src/emails --port 3002",
    "build": "email build --dir src/emails --packageManager pnpm",
    "check-types": "tsc --noEmit",
    "resend": "email resend reset && pnpm resend:setup",
    "resend:setup": "email resend setup"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@tablekeep/shared": "workspace:*",
    "react-email": "^6.9.1",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.1",
    "@tablekeep/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
