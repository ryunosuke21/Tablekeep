{
  "name": "Tablekeep",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "auth:generate": "turbo run auth:generate -F web",
    "build": "turbo run build",
    "check": "biome check --write .",
    "check-types": "turbo run check-types",
    "check:ci": "biome ci .",
    "db:push": "turbo run db:push -F web",
    "db:studio": "turbo run db:studio -F web",
    "db:generate": "turbo run db:generate -F web",
    "db:migrate": "turbo run db:migrate -F web",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev -F docs",
    "dev:web": "turbo run dev -F web",
    "email": "turbo run dev -F @tablekeep/emails",
    "party:deploy": "pnpm --filter web party:deploy",
    "party:dev": "pnpm --filter web party:dev",
    "party:login": "pnpm --filter web party:login",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "ci": "pnpm check:ci && pnpm check-types && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tablekeep/config": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "portless": "^0.15.6",
    "turbo": "^2.11.3",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.5.1"
}
